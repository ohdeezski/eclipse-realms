# Eclipse Realms - Git Ignore File
# This file specifies intentionally untracked files to ignore

# ============================================================================
# GODOT SPECIFIC IGNORES
# ============================================================================

# Godot 4.x specific ignores
.godot/

# Godot-specific ignores
*.translation

# Godot swap files
data_*.swp

# ============================================================================
# USER DATA
# ============================================================================

# User-specific save files
user://*

# Save files
saves/*
*.eclipse

# Configuration
config.cfg
user://config.cfg

