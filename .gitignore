docs/*.tmp
docs/*.bak
docs/backup/*

# ============================================================================
# SERVER SPECIFIC
# ============================================================================

server/database/*.db
server/database/*.sqlite
server/database/*.sqlite-journal
server/logs/*
server/temp/*
server/uploads/*

# Environment and config
server/.env

# Secret files (e.g. db_password.txt placeholder + real secrets) — never commit
secrets/
server/secrets/

# Node.js server
dist/
coverage/

# ============================================================================
# SHARED RESOURCES
# ============================================================================

shared/schemas/*.backup
shared/game_data/*.backup
shared/localization/*.backup

# ============================================================================
# TOOLS AND BUILD SCRIPTS
# ============================================================================

tools/bin/
tools/build/
tools/dist/
tools/*.exe
tools/*.sh

# ============================================================================
# PACKAGES AND PLUGINS
# ============================================================================

addons/*/.*
addons/*/.git*
addons/*/.gitignore
addons/*/README* 

# Godot Asset Library
godot-asset-library/*

# ============================================================================
# TEST FILES
# ============================================================================

# Test data that shouldn't be committed
tests/fixtures/*
tests/mocks/*
tests/temp/*

# Test results
test-results/
coverage/

# ============================================================================
# MISC
# ============================================================================

# Crash reports
crash.*

# Memory dumps
*.dmp

# Temporary files
*.temp
*.tmp

# Backup files
*.bak
*.backup
*~

# Swap files
*.swp

# Emergency recovery files
*.emergency-recovery

# ============================================================================
# WHAT TO COMMIT
# ============================================================================
# 
# COMMIT THESE:
# - Source code (*.gd, *.py, *.js, *.ts, etc.)
# - Scene files (*.tscn, *.res)
# - Asset source files (images, sounds, models in source format)
# - Configuration files (project.godot, *.json, *.yaml)
# - Documentation (*.md, *.txt)
# - Shaders (*.shader, *.gdshader)
# - Scripts and tools
# - Godot project files
#
# DO NOT COMMIT:
# - Compiled binaries
# - User data (saves, configs)
# - Build outputs
# - Temporary files
# - IDE-specific files (except essential configs)
# - Dependency directories (node_modules, etc.)
# - Large binary assets (use git LFS if necessary)
#
# =============================================================================orca-linux.AppImage
orca-linux.AppImage
.import
.remap
.wasm

